<?xml version="1.0" encoding="utf-8"?>
<robot name="balance_car">

  <mujoco>
    <compiler meshdir="D:\\Git-Project\\mjlab\\src\\mjlab\\asset_zoo\\robots\\balance_car\\xmls\\meshes" discardvisual="false"/>
  </mujoco>

  <!-- [CAUTION] uncomment when convert to mujoco -->
  <link name="world"></link>
  <joint name="floating_base_joint" type="floating">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-5.8344E-18 -5.5983E-18 0.035" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.00094167" ixy="0" ixz="0" iyy="0.00070833" iyz="0" izz="0.00083333" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.95686 0.84706 0.58039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.08 0.07" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="-0.0001449 0.0225 0.00026239" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.00012358" ixy="0" ixz="-0.00000118" iyy="0.00014740" iyz="0" izz="0.00012507" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.90588 0.21569 0.20784 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.0225 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.045" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.04 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <axis xyz="0 -1 0" />
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="-0.0001449 -0.0225 0.00026239" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.00012358" ixy="0" ixz="-0.00000118" iyy="0.00014740" iyz="0" izz="0.00012507" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.90588 0.21569 0.20784 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.0225 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.045" />
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.04 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <axis xyz="0 -1 0" />
  </joint>
</robot>